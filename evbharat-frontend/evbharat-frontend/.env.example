# Frontend environment variables
# Copy this file to .env and adjust as needed.

# Optional: explicit backend base URL. Leave empty in dev to use Vite proxy (/api -> localhost:3001).
# VITE_API_BASE_URL=http://localhost:3001

# Optional: Vite proxy upstream overrides (advanced).
# Use these when you move backend service ports.
# VITE_NODE_API_TARGET=http://127.0.0.1:3001
# VITE_RAG_API_TARGET=http://127.0.0.1:9000
# VITE_ML_API_TARGET=http://127.0.0.1:8010

# Safety default: keep offline auth disabled so invalid credentials are rejected by backend.
VITE_ENABLE_OFFLINE_AUTH=false

# Base URL for the YOLO detection stream proxy (FastAPI service).
VITE_YOLO_STREAM_URL=http://localhost:8000/stream
